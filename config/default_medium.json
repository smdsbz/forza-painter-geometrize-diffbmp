{
    "preprocessing": {
        "final_resolution": 640,
        "square_crop": false,
        "exist_bg": true,
        "resampling": "LANCZOS"
    },
    "primitive": {
        "output_width": 128,
        "primitive_file": [
            "primitives/circle/1x1.png",
            "primitives/circle/1x4.png",
            "primitives/circle/1x8.png",
            "primitives/square/1x1.png",
            "primitives/square/1x4.png",
            "primitives/square/1x8.png",
            "primitives/triangle-isosceles/1x1.png",
            "primitives/triangle-isosceles/1x4.png",
            "primitives/triangle-isosceles/1x8.png",
            "primitives/triangle-isosceles/1x16.png",
            "primitives/triangle-isosceles/4x1.png",
            "primitives/triangle-isosceles/8x1.png",
            "primitives/triangle-isosceles/16x1.png",
            "primitives/triangle-right/1x1.png",
            "primitives/triangle-right/1x4.png",
            "primitives/triangle-right/1x8.png",
            "primitives/triangle-right/1x16.png",
            "primitives/triangle-right/4x1.png",
            "primitives/triangle-right/8x1.png",
            "primitives/triangle-right/16x1.png"
        ]
    },
    "initialization": {
        "initializer": "structure_aware",
        "N": 1500,
        "radii_min": 1,
        "radii_max": 50,
        "detail_first": true,
        "max_prims_per_pixel": 400
    },
    "optimization": {
        "num_iterations": 300,
        "alpha_upper_bound": 1.0,
        "c_blend": 0.0,
        "tile_size": 32,
        "learning_rate": {
            "default": 0.1
        },
        "do_decay": true,
        "decay_rate": 0.99,
        "do_gaussian_blur": true,
        "blur_sigma": 1.0,
        "loss_config": {
            "type": "combined",
            "components": [
                { "name": "mse", "weight": 1.0 },
                { "name": "alpha", "weight": 0.1 }
            ]
        },
        "pruning": {
            "do_pruning": true,
            "prune_iterations": 200,
            "no_prune_last_iterations": 10,
            "no_prune_warmup_iterations": 150,
            "prune_threshold": 0.1
        }
    },
    "postprocessing": {
        "output_folder": "./outputs/",
        "compute_psnr": true,
        "export_psd": false
    }
}
