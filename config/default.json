{
    "preprocessing": {
        "final_width": 1080,
        "square_crop": true,
        "exist_bg": true,
        "resampling": "LANCZOS"
    },
    "primitive": {
        "output_width": 256,
        "primitive_file": [
            "primitives/circle/1x1.png",
            "primitives/circle/1x2.png",
            "primitives/circle/1x3.png",
            "primitives/circle/1x4.png",
            "primitives/circle/1x5.png",
            "primitives/square/1x1.png",
            "primitives/square/1x2.png",
            "primitives/square/1x3.png",
            "primitives/square/1x4.png",
            "primitives/square/1x5.png",
            "primitives/triangle-isosceles/1x1.png",
            "primitives/triangle-isosceles/1x2.png",
            "primitives/triangle-isosceles/1x3.png",
            "primitives/triangle-isosceles/1x4.png",
            "primitives/triangle-isosceles/1x5.png",
            "primitives/triangle-isosceles/2x1.png",
            "primitives/triangle-isosceles/3x1.png",
            "primitives/triangle-isosceles/4x1.png",
            "primitives/triangle-isosceles/5x1.png",
            "primitives/triangle-right/1x1.png",
            "primitives/triangle-right/1x2.png",
            "primitives/triangle-right/1x3.png",
            "primitives/triangle-right/1x4.png",
            "primitives/triangle-right/1x5.png",
            "primitives/triangle-right/2x1.png",
            "primitives/triangle-right/3x1.png",
            "primitives/triangle-right/4x1.png",
            "primitives/triangle-right/5x1.png"
        ]
    },
    "initialization": {
        "initializer": "structure_aware",
        "N": 5000,
        "radii_min": 2,
        "radii_max": null,
        "detail_first": true
    },
    "optimization": {
        "num_iterations": 300,
        "alpha_upper_bound": 1.0,
        "c_blend": 0.0,
        "tile_size": 32,
        "do_gaussian_blur": false,
        "do_adapt_gaussian_blur": true,
        "blur_sigma_start": 2.0,
        "blur_sigma_end": 0.0,
        "loss_config": {
            "type": "combined",
            "components": [
                { "name": "mse", "weight": 1.0 },
                { "name": "perceptual", "weight": 0.3 }
            ]
        },
        "pruning": {
            "do_pruning": true,
            "prune_iterations": 50,
            "no_prune_last_iterations": 10,
            "no_prune_warmup_iterations": 100,
            "prune_threshold": 0.3
        }
    },
    "postprocessing": {
        "output_folder": "./outputs/"
    }
}
